{
  "name": "nbr-17225-guard",
  "private": true,
  "version": "1.1.3",
  "description": "Verificador profissional de acessibilidade web conforme ABNT NBR 17225:2025",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "commitlint:edit": "node scripts/check-commits.mjs --edit",
    "commitlint:push": "node scripts/check-commits.mjs --pre-push",
    "commitlint:range": "node scripts/check-commits.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "stage-lint": "lint-staged",
    "preview": "vite preview",
    "test": "pnpm test:dom-identifiers && pnpm test:extension-storage && pnpm test:audit-history-utils && pnpm test:audit-import && pnpm test:audit-history && pnpm test:audit-triage && pnpm test:audit-manual-findings && pnpm test:audit-bulk-actions && pnpm test:contrast-preview && pnpm test:audit-alt-report-devtools",
    "verify:rules": "node scripts/verify-rules.mjs",
    "type-check": "tsc --noEmit",
    "test:dom-identifiers": "node scripts/test-dom-identifiers.mjs",
    "test:extension-storage": "node scripts/test-extension-storage.mjs",
    "test:audit-history": "node scripts/test-audit-history.mjs",
    "test:audit-import": "node scripts/test-audit-import.mjs",
    "test:audit-history-utils": "node scripts/test-audit-history-utils.mjs",
    "test:audit-manual-findings": "node scripts/test-audit-manual-findings.mjs",
    "test:audit-bulk-actions": "node scripts/test-audit-bulk-actions.mjs",
    "test:contrast-preview": "node scripts/test-contrast-preview.mjs",
    "test:audit-triage": "node scripts/test-audit-triage.mjs",
    "test:audit-alt-report-devtools": "node scripts/test-audit-alt-report-devtools.mjs"
  },
  "lint-staged": {
    "*.{md,json,css,js,mjs,ts,tsx,html}": [
      "prettier --write"
    ],
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "antd": "^6.3.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.1.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.4",
    "@types/chrome": "^0.1.38",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
